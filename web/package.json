{
  "name": "meridian-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Static dashboard for Meridian run results: pass^k, intervals, harness errors by cause, and run comparison.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
